DATABASE_URL=postgresql://lmnt:lmnt_dev@127.0.0.1:5432/lmnt_coach_os
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Copy to .env for local development (used by drizzle-kit and seed scripts):
#   cp .env.example .env
#
# Next.js also loads .env.local automatically (overrides .env).

# Ollama (local AI — optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=llama3.2
# OLLAMA_API_KEY=
# OLLAMA_ALLOW_REMOTE=true

# SMTP (Gmail app password — never commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_MAIL=
APP_URL=http://localhost:3000

# Docker Postgres (optional override; compose defaults to lmnt_dev on localhost only)
# POSTGRES_PASSWORD=

