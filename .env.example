DATABASE_URL=postgresql://postgres:password123@YOUR_RDS_HOST:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=postgres
RDS_HOST=YOUR_RDS_HOST
SESSION_SECRET=change-me-to-a-long-random-string-in-production

# Copy to .env for local development (used by drizzle-kit and seed scripts):
#   cp .env.example .env
#
# Next.js also loads .env.local automatically (overrides .env).

# Ollama (local AI — optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=llama3.2
# OLLAMA_API_KEY=
# OLLAMA_ALLOW_REMOTE=true

# SMTP (Gmail app password — never commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_MAIL=
APP_URL=https://lmnt.fit
